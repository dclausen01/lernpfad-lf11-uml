@startuml
!include stil.iuml
left to right direction
rectangle "✗ falsch: Ablauf als Kette – das wäre ein Aktivitätsdiagramm" as F {
  actor Kunde as K1
  usecase "Einloggen" as A1
  usecase "Artikel suchen" as A2
  usecase "Bezahlen" as A3
  K1 -- A1
  A1 --> A2
  A2 --> A3
}
rectangle "✓ richtig: Funktionen aus Sicht des Akteurs" as R {
  actor Kunde as K2
  rectangle "Webshop" {
    usecase "Artikel suchen" as B2
    usecase "Bestellung aufgeben" as B3
    usecase "Bezahlen" as B4
  }
  K2 -- B2
  K2 -- B3
  B3 ..> B4 : <<include>>
}
@enduml
