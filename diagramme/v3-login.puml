@startuml
!include stil.iuml
skinparam style strictuml
hide footbox
actor ":Benutzer" as U
participant ":Onlineportal" as P
participant ":Datenbank" as DB
group loop(1,3) [nicht angemeldet]
  U -> P : login(name, pw)
  activate P
  P -> DB : pruefe(name, pw)
  activate DB
  DB -->> P : ergebnis
  deactivate DB
  alt ergebnis = ok
    P -->> U : "Anmeldung erfolgreich"
  else versuche < 3
    P -->> U : "Daten falsch"
  else else
    P -->> U : "Konto gesperrt"
  end
  deactivate P
end
@enduml
